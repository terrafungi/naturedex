{
  "projectId": "5ef4a651b9a3",
  "region": "eu-central-1",
  "backend": "elastic",
  "postgres": true,
  "storage": {
    "cloudfront": "media"
  },
  "mqtt": false,
  "functions": [
    {
      "name": "api",
      "runtime": "nodejs24.x",
      "memory": 512,
      "timeout": 120,
      "schedule": "rate(1 minute)"
    }
  ],
  "site": "./site",
  "spa": "/index.html",
  "redirects": {
    "rules": [
      {
        "from": "/blog",
        "to": "/api/blog",
        "status": 301
      },
      {
        "from": "/blog/*",
        "to": "/api/blog/:splat",
        "status": 301
      }
    ]
  }
}
